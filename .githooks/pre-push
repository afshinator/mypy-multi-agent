#!/bin/sh
# The every-change gate before a push (issue #123). Install once per clone:
#   just hooks   (git config core.hooksPath .githooks)
# `bun run check` rather than `just check`, so the hook needs only bun.
# Bypass with `git push --no-verify`; CI runs the same gate either way.
#
# Issue #141: refuse a push to main here to name the remedy locally, because
# GitHub's own refusal names none. This hook is a convenience, not the gate:
# `--no-verify` skips it. The gate is the server-side `main-protection` ruleset
# (no force-push, no delete, green `check`, and a pull request is required).
# stdin is one line per ref:
#   <local ref> <local sha> <remote ref> <remote sha>
set -e
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            echo "main is protected; use \`just land\` (push the task branch, PR, merge)." >&2
            exit 1
            ;;
    esac
done
bun run check
