{
  "name": "multi-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "start": "bun src/pi/launch.ts",
    "test": "vitest run",
    "test:jev": "JEV_LIVE=1 vitest run test/integration/jev-live.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "collect": "bun src/scorecard/collector.ts",
    "trends": "bun src/scorecard/trends.ts",
    "improvements": "bun src/scorecard/improvements.ts",
    "check-citations": "bun scripts/check-citations.ts"
  },
  "bin": {
    "mypi-run": "./src/pi/launch.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "typebox": "1.3.27",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
